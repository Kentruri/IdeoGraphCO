# El corpus vive en un dataset privado de Hugging Face; en git solo va
# data/corpus.lock con la revisión (ver scripts/dataset_sync.py).
data/scraper_history.db
data/scraper_history.db-wal
data/scraper_history.db-shm
**/.silver_cursor
**/*.jsonl.cursor
**/*.jsonl.failed
**/.label_cursor
**/.filter_cursor
**/.clean_cursor
*.bak

# Logs y checkpoints
logs/
*.ckpt
*.pt
*.bin

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Entornos
.env
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# MLflow / Weights & Biases
mlruns/
wandb/

# Claude Code (config local del IDE)
# Config local de Claude Code, salvo el agente y el codebook del filtro: son
# metodología del proyecto (producto P1.2) y el otro investigador los necesita.
# Con un directorio excluido git no puede re-incluir lo de dentro, de ahí el `*`.
.claude/*
!.claude/agents/
!.claude/skills/

# Corpus y estado de ejecución: NUNCA por git. El corpus viaja por Hugging
# Face (data/corpus.lock sí se versiona; el contenido no) y agent_batches es estado
# vivo del filtrado. Sin esto, un `git add .` intenta subir ~600 MB.
data/raw/
data/agent_batches/

# Paquetes para anotadores: se regeneran con scripts/package_for_annotator.py
annotation/paquetes/

# Salida de scripts/generate_sample.py: se regenera, no se versiona
muestra_ideologica*.xlsx
